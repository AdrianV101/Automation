# Agent SDK auth: uses your Claude subscription via `claude` CLI.
# No ANTHROPIC_API_KEY needed — the SDK picks up ~/.claude/ credentials.

TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789
PKM_VAULT_PATH=/path/to/your/obsidian/vault
OBSIDIAN_MCP_SERVER_PATH=/path/to/obsidian-mcp/index.js

# Email ingestion (Proton Mail Bridge -> IMAP IDLE)
EMAIL_INGEST_ENABLED=true
IMAP_HOST=127.0.0.1
IMAP_PORT=1143
IMAP_USER=transcripts@example.com
IMAP_PASSWORD=
EMAIL_INGEST_STATE_DB_PATH=./email_ingest_state.db
VAULT_ATTACHMENTS_SUBDIR=99-Attachments/plaud
# Proton Mail Bridge: STARTTLS upgrade on port 1143 with self-signed cert
IMAP_USE_STARTTLS=true
IMAP_SSL_VERIFY=false

# WhisperX Local Transcription
WHISPERX_ENABLED=false
HF_TOKEN=hf_...
WHISPERX_DEVICE=auto
WHISPERX_COMPUTE_TYPE=auto
WHISPERX_BATCH_SIZE=4
WHISPERX_MODEL=large-v3
WHISPERX_TIMEOUT_SECONDS=600
WAV_DIR=./audio_downloads/wav

# Speaker Identification
SPEAKER_PROFILES_DIR=./speaker_profiles
SPEAKER_SIMILARITY_THRESHOLD=0.65

# Speaker Clustering & Refinement
SPEAKER_CLUSTER_THRESHOLD=0.70
SPEAKER_REFINEMENT_THRESHOLD=0.85
SPEAKER_REFINEMENT_ALPHA=0.1

# Session capture (writes devlog entries after each extraction).
# Off by default. Enabling doubles the per-recording agent-loop cost
# (a second short SDK pass writes the devlog). Re-evaluate after a
# week of dogfood data once flipped on.
ENABLE_SESSION_CAPTURE=false
