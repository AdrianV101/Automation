# Agent SDK auth: uses your Claude subscription via `claude` CLI.
# No ANTHROPIC_API_KEY needed — the SDK picks up ~/.claude/ credentials.

TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789
PKM_VAULT_PATH=/path/to/your/obsidian/vault
OBSIDIAN_MCP_SERVER_PATH=/path/to/obsidian-mcp/index.js

# Email ingestion (Proton Mail Bridge -> IMAP IDLE)
EMAIL_INGEST_ENABLED=true
IMAP_HOST=127.0.0.1
IMAP_PORT=1143
IMAP_USER=transcripts@example.com
IMAP_PASSWORD=
EMAIL_INGEST_STATE_DB_PATH=./email_ingest_state.db
VAULT_ATTACHMENTS_SUBDIR=99-Attachments/plaud
# Proton Mail Bridge: STARTTLS upgrade on port 1143 with self-signed cert
IMAP_USE_STARTTLS=true
IMAP_SSL_VERIFY=false

# News ingestion (parallel listener for news@veraz.dev newsletters).
# Same Bridge connection, separate Proton folder, separate state table,
# separate Telegram topic.
NEWS_INGEST_ENABLED=false
NEWS_IMAP_FOLDER=Folders/News
NEWS_TELEGRAM_TOPIC_ID=
# Set only if Bridge is in "split" address mode; empty = share IMAP_USER.
NEWS_IMAP_USER=

# WhisperX Local Transcription
WHISPERX_ENABLED=false
HF_TOKEN=hf_...
WHISPERX_DEVICE=auto
WHISPERX_COMPUTE_TYPE=auto
WHISPERX_BATCH_SIZE=4
WHISPERX_MODEL=large-v3
WHISPERX_TIMEOUT_SECONDS=600
WAV_DIR=./audio_downloads/wav

# Speaker Identification
SPEAKER_PROFILES_DIR=./speaker_profiles
SPEAKER_SIMILARITY_THRESHOLD=0.65

# Speaker Clustering & Refinement
SPEAKER_CLUSTER_THRESHOLD=0.70
SPEAKER_REFINEMENT_THRESHOLD=0.85
SPEAKER_REFINEMENT_ALPHA=0.1

# Session capture (writes devlog entries after each extraction).
# Off by default. Enabling adds one short SDK pass per recording
# (capped at 15 turns vs. extraction's 150-turn cap). Real per-recording
# extraction cost is workload-dependent -- collect dogfood data before
# keeping this on long-term.
ENABLE_SESSION_CAPTURE=false

# ─── News Daily Master Document ─────────────────────────────────────────────
# Phase 1 Task 2 of news-ingestion-roadmap. See ADR-005 in vault.
# In-daemon scheduler runs a Claude Opus 4.7 agent at NEWS_DAILY_MASTER_LOCAL_TIME
# each day to produce 01-Projects/News/daily/<yesterday>-master.md.
NEWS_DAILY_MASTER_ENABLED=false
NEWS_DAILY_MASTER_LOCAL_TIME=06:00              # HH:MM in system local tz
NEWS_DAILY_MASTER_BACKFILL_DAYS=3               # max days to backfill on boot
NEWS_DAILY_MASTER_MODEL=claude-opus-4-7
NEWS_DAILY_MASTER_TZ=                           # empty=use localtime; set IANA name (e.g. Europe/London)
NEWS_DAILY_TELEGRAM_TOPIC_ID=                   # provision a "News Daily Digest" topic
