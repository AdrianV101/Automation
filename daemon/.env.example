# Agent SDK auth: uses your Claude subscription via `claude` CLI.
# No ANTHROPIC_API_KEY needed — the SDK picks up ~/.claude/ credentials.

TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789
PKM_VAULT_PATH=/path/to/your/obsidian/vault
OBSIDIAN_MCP_SERVER_PATH=/path/to/obsidian-mcp/index.js

# Email listener (Proton Mail Bridge -> IMAP IDLE; forwards new mail to Poke)
EMAIL_INGEST_ENABLED=true
IMAP_HOST=127.0.0.1
IMAP_PORT=1143
IMAP_USER=you@example.com
IMAP_PASSWORD=
EMAIL_INGEST_STATE_DB_PATH=./email_ingest_state.db
# Proton Mail Bridge: STARTTLS upgrade on port 1143 with self-signed cert
IMAP_USE_STARTTLS=true
IMAP_SSL_VERIFY=false

# News ingestion (parallel listener for news@veraz.dev newsletters).
# Same Bridge connection, separate Proton folder, separate state table,
# separate Telegram topic.
NEWS_INGEST_ENABLED=false
NEWS_IMAP_FOLDER=Folders/News
NEWS_TELEGRAM_TOPIC_ID=
# Set only if Bridge is in "split" address mode; empty = share IMAP_USER.
NEWS_IMAP_USER=

# Session capture (writes devlog entries after each extraction).
# Off by default. Enabling adds one short SDK pass per recording
# (capped at 15 turns vs. extraction's 150-turn cap). Real per-recording
# extraction cost is workload-dependent -- collect dogfood data before
# keeping this on long-term.
ENABLE_SESSION_CAPTURE=false

# ─── News Daily Master Document ─────────────────────────────────────────────
# In-daemon scheduler runs a Claude Opus 4.7 agent at NEWS_DAILY_MASTER_LOCAL_TIME
# each day to produce 01-Projects/News/daily/<yesterday>-master.md.
NEWS_DAILY_MASTER_ENABLED=false
NEWS_DAILY_MASTER_LOCAL_TIME=06:00              # HH:MM in system local tz
NEWS_DAILY_MASTER_BACKFILL_DAYS=3               # max days to backfill on boot
NEWS_DAILY_MASTER_MODEL=claude-opus-4-7
NEWS_DAILY_MASTER_TZ=                           # empty=use localtime; set IANA name (e.g. Europe/London)
NEWS_DAILY_TELEGRAM_TOPIC_ID=                   # provision a "News Daily Digest" topic

# News personal digest (Phase 3) — chained after the daily master.
# Reuses NEWS_DAILY_TELEGRAM_TOPIC_ID for delivery (same topic).
NEWS_PERSONAL_DIGEST_ENABLED=false
NEWS_PERSONAL_DIGEST_MODEL=claude-opus-4-7
NEWS_PERSONAL_DIGEST_FEEDBACK_WINDOW_DAYS=7
NEWS_PERSONAL_DIGEST_MIN_ITEMS=4
NEWS_PERSONAL_DIGEST_MAX_ITEMS=12

# ─── Clippings auto-ingest ───────────────────────────────────────────────────
# Watches a vault folder for files saved by Obsidian Web Clipper, routes each
# clipping to the appropriate vault location via a Claude agent.
CLIPPINGS_ENABLED=false
CLIPPINGS_DIR=Clippings                         # vault-relative folder the Obsidian Web Clipper writes to
CLIPPINGS_SETTLE_SECONDS=5                      # debounce: wait this long for a file to stop changing before processing
CLIPPINGS_RECONCILE_INTERVAL_SECONDS=3600       # periodic full-folder reconciliation sweep interval
CLIPPINGS_MAX_FAILED_RETRIES=3                  # give up re-routing a clipping after this many failures
CLIPPINGS_MODEL=claude-opus-4-7                 # model for the clipping routing agent

# Poke real-time forwarding: POST a structured JSON record (sender, subject,
# body, received_at) of every new inbox email to a Poke ingest endpoint. The
# URL is self-authenticating (token embedded). Off until POKE_INGEST_URL is set.
POKE_INGEST_URL=                                 # https://poke.com/api/v1/inbound/ingest/<token>

# Plaud MCP ingest: polls the Plaud MCP server (spawned via npx) for recordings
# with a transcript and summary, and ingests them once speakers are labelled in
# the Plaud app: immediately when no generic "Speaker N" is left, after the
# quiet period when only some are named, or after the fallback if untouched.
# Uses the OAuth tokens in ~/.plaud/tokens-mcp.json (log in once on this host).
ENABLE_PLAUD_MCP_INGEST=false
PLAUD_MCP_SWITCHOVER_DATE=                      # YYYY-MM-DD; required when enabled. Recordings before this are only ingested via `plaud-ingest`
PLAUD_MCP_PACKAGE=@plaud-ai/mcp@0.3.14          # must pin a version; @latest or no version is rejected
PLAUD_MCP_POLL_INTERVAL_S=300                   # seconds between polls
PLAUD_MCP_LABEL_QUIET_S=600                     # while some speakers are still generic, ingest this long after the last label change
PLAUD_MCP_UNLABELLED_FALLBACK_S=86400           # ingest anyway (speakers unresolved) this long after ready
PLAUD_MCP_WINDOW_DAYS=14                        # how far back each poll lists recordings

# News auto-research (deep-dives the agent-selected top items between master
# and digest, enriching the master in place). Off by default until soaked.
NEWS_RESEARCH_ENABLED=false
NEWS_RESEARCH_MODEL=claude-sonnet-4-6
NEWS_RESEARCH_MAX_ITEMS=3
NEWS_RESEARCH_MAX_TURNS=60
